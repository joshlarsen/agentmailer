{
  "name": "agentmailer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-13",
  "vars": {
    "MAIL_DOMAIN": "agents.example.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentmailer",
      "database_id": "local-placeholder",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "MAIL", "bucket_name": "agentmailer" }],
  "triggers": { "crons": ["*/15 * * * *"] },
}
