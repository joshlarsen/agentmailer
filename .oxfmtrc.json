{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "jsdoc": true,
  "printWidth": 80,
  "semi": false,
  "singleQuote": true,
  "sortPackageJson": true,
  "sortImports": true,
  "ignorePatterns": [
    "node_modules/**",
    ".wrangler/**",
    "coverage/**",
    "docs/planning/**",
    "package-lock.json",
    ".deployment.json",
    "wrangler.deploy.json"
  ]
}
