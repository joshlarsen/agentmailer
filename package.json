{
  "name": "agentmailer",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted email for AI agents on Cloudflare",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc && tsc -p tsconfig.test.json",
    "test": "vitest run && node --test test/setup.test.mjs",
    "setup": "node scripts/setup.mjs",
    "deploy": "wrangler deploy --config wrangler.deploy.json",
    "upgrade": "node scripts/setup.mjs --upgrade",
    "doctor": "node scripts/setup.mjs --doctor",
    "format": "oxfmt --write .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --deny-warnings --fix .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "hono": "^4.13.18",
    "postal-mime": "^4.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@cloudflare/workers-types": "^5.20261113.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "engines": {
    "node": ">=24"
  }
}
